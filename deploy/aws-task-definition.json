{
  "family": "micronomy",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::123456789012:role/micronomyTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/micronomyTaskRole",
  "containerDefinitions": [
    {
      "name": "micronomy",
      "image": "replaced-by-the-workflow",
      "essential": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "MICRONOMY_HOST", "value": "0.0.0.0" },
        { "name": "MICRONOMY_PORT", "value": "8080" },
        { "name": "MACONOMY_URL", "value": "https://b3iaccess.deltekenterprise.com" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/micronomy",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
